# Minimal kernel config for 386root
# Target: Intel 386, QEMU + 86box, serial console
# All unset options get kernel defaults via make oldconfig

# General setup
CONFIG_EXPERIMENTAL=y
CONFIG_SYSVIPC=y
CONFIG_NO_HZ=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZMA=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_UID16=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y

# Loadable module support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Processor type and features
CONFIG_M386=y
CONFIG_MATH_EMULATION=y
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_NOHIGHMEM=y
CONFIG_FLATMEM=y
CONFIG_FLAT_NODE_MEM_MAP=y
CONFIG_VMSPLIT_3G=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=4096
CONFIG_X86_PAT=y

# Bus options
CONFIG_PCI=y
CONFIG_PCI_BIOS=y
CONFIG_PCI_DIRECT=y

# Binary formats
CONFIG_BINFMT_ELF=y

# SCSI (core built-in for libata)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ATA (libata) - built-in for disk boot
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_PATA_LEGACY=y

# Network stack (built-in, drivers as modules)
CONFIG_NET=y
CONFIG_PACKET=m
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y

# Network drivers as modules
CONFIG_NET_VENDOR_3COM=y
CONFIG_EL3=m
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=m
CONFIG_NET_VENDOR_RTL=y
CONFIG_8139TOO=m
CONFIG_NE2K_PCI=m
CONFIG_NE2K=m
CONFIG_TUN=m

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y

# Character devices / serial
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# Block devices
CONFIG_BLK_DEV_FD=m
CONFIG_BLK_DEV_RAM=m
CONFIG_BLK_DEV_RAM_SIZE=4096

# SCSI generic
CONFIG_CHR_DEV_SG=m

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT3_FS=y
CONFIG_EXT2_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Sound (infrastructure built-in, drivers as modules)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=m
CONFIG_SND_ENS1371=m
CONFIG_SND_RAWMIDI=m

# Security
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y

# Crypto (minimal)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_CBC=m
CONFIG_CRYPTO_AES=m
CONFIG_CRYPTO_CRC32C=y

# Kernel hacking
CONFIG_MAGIC_SYSRQ=y
